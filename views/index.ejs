<%- include('partials/header', { title }) %>

<main>
  <section id="home" class="hero-section">
    <div class="container">
      <div class="row align-items-center min-vh-75">
        <div class="col-lg-7 hero-content">
          <span class="eyebrow"><i class="bi bi-heart-pulse-fill"></i> HEALTHCARE INFORMATION</span>
          <h1>Solusi kesehatan untuk hidup yang <span>lebih baik.</span></h1>
          <p class="lead">Temukan informasi layanan dan produk kesehatan dengan mudah melalui Medilab.</p>
          <a href="#produk" class="btn btn-primary btn-lg rounded-pill px-4">Jelajahi Produk <i class="bi bi-arrow-right ms-2"></i></a>
          <a href="#layanan" class="btn btn-outline-primary btn-lg rounded-pill px-4 ms-2">Pelajari</a>
        </div>
        <div class="col-lg-5 d-none d-lg-block">
          <div class="hero-card">
            <div class="hero-icon"><i class="bi bi-hospital"></i></div>
            <h3>Care for your health</h3>
            <p>Informasi kesehatan dalam satu halaman.</p>
            <div class="hero-stat"><i class="bi bi-check-circle-fill"></i> Mudah diakses dan informatif</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="layanan" class="section-padding">
    <div class="container">
      <div class="section-heading text-center">
        <span>LAYANAN KAMI</span>
        <h2>Kenali Layanan Medilab</h2>
        <p>Informasi yang disusun agar kebutuhan kesehatan lebih mudah ditemukan.</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="service-card h-100">
            <i class="bi bi-capsule"></i><h4>Informasi Produk</h4>
            <p>Lihat daftar produk kesehatan beserta kategori dan harganya.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="service-card h-100">
            <i class="bi bi-clipboard2-pulse"></i><h4>Informasi Kesehatan</h4>
            <p>Temukan informasi dasar untuk membantu kebutuhan sehari-hari.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="service-card h-100">
            <i class="bi bi-chat-dots"></i><h4>Layanan Informasi</h4>
            <p>Hubungi kami untuk mendapatkan informasi lebih lanjut.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="produk" class="section-padding products-section">
    <div class="container">
      <div class="section-heading text-center">
        <span>DAFTAR PRODUK</span>
        <h2>Produk Kesehatan</h2>
        <p>Data berikut diambil dari Model melalui Controller Express, lalu ditampilkan menggunakan EJS.</p>
      </div>
      <div class="row g-4">
        <% products.forEach((product) => { %>
          <div class="col-sm-6 col-lg-3">
            <article class="product-card h-100">
              <div class="product-icon"><i class="bi bi-prescription2"></i></div>
              <div class="product-body">
                <span class="product-category"><%= product.kategori %></span>
                <h5><%= product.nama %></h5>
                <p><%= product.deskripsi %></p>
                <div class="product-price">Rp <%= product.harga.toLocaleString('id-ID') %></div>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
      <div class="text-center mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" href="/api/produk" target="_blank">Lihat JSON API Produk <i class="bi bi-box-arrow-up-right ms-1"></i></a>
      </div>
    </div>
  </section>

  <section class="api-section section-padding">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <span class="eyebrow">REST API</span>
          <h2>Backend terintegrasi dengan frontend</h2>
          <p>Project ini menyediakan endpoint untuk memeriksa status server dan mengambil data produk dalam format JSON.</p>
        </div>
        <div class="col-lg-5">
          <div class="api-link"><span>GET</span><code>/api/status</code><a href="/api/status" target="_blank">Coba</a></div>
          <div class="api-link"><span>GET</span><code>/api/produk</code><a href="/api/produk" target="_blank">Coba</a></div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
